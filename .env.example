# Copy to .env and fill in. NEVER put real keys in this file: it is committed to a public repo.

# LLM Provider: groq | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=

# Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant (local: host/port; cloud: url + api key)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sadhguru_wisdom_v3

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
OPENAI_API_KEY=

# Reranker: flashrank | jev | bge  (jev gives the best retrieval; needs OPENROUTER_API_KEY)
RERANKER_PROVIDER=flashrank
# Jev (TypeSafe) via OpenRouter - needed for RERANKER_PROVIDER=jev, the relevance gate and the topic guardrail
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# BGE (local) needs: pip install sentence-transformers
BGE_MODEL=BAAI/bge-reranker-v2-m3

# Logfire
LOGFIRE_TOKEN=

# API
API_HOST=0.0.0.0
API_PORT=8000
